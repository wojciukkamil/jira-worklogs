<script>
    $(document).ready(function() {
       $('#ajaxSelect').select2({

        dropdownParent: '#addEventModal', // Ustawienie rodzica dropdownu na modal

        allowClear: true,
         theme: 'bootstrap-5', // Motyw Bootstrap 5
         placeholder: 'Wpisz szukaną frazę',
         minimumInputLength: 2, // Minimalna liczba znaków do rozpoczęcia wyszukiwania
         ajax: {
             url: '/worklogs/search', // URL do skryptu AJAX
             dataType: 'json',
             delay: 250, // Opóźnienie przed wysłaniem zapytania
             data: function (params) {
                 return {
                     search: params.term // Fraza wyszukiwania
                 };
             },
             processResults: function (data) {
                 return {
                     results: $.map(data, function (item) {
                         return {
                             text: item.name, // Co wyświetlić
                             id: item.key // Co pobrać
                         }
                     })
                 };
             },
             cache: true
         }
     });

    });
</script>

<style>
    .select2-container--bootstrap-5 .select2-selection--single {
        height: 38px; /* Dopasuj do wysokości inputa */
        padding: 6px 12px; /* Dopasuj do paddingu inputa */
    }

    .select2-selection__clear {
        color:rgb(125, 108, 108); /* Kolor ikony "x" */
    }
</style>
