<form action="/worklogs/edit" method="get" id="worklogForm">
    <div class="input-group input-group-lg">
        <span class="input-group-text" id="inputGroup-sizing-lg">Jira task: </span>
        <input type="text" class="form-control" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-lg" value="{{ issue.key }}" disabled readonly>
    </div>
	<div class="mb-3">
		<label for="message-text" class="col-form-label"></label>
		<textarea class="form-control" id="message-text" disabled readonly>{{ issue.fields.summary }}</textarea>
	</div>
	{# <div class="mb-3">
		<label for="recipient-name" class="col-form-label">Zadanie:</label>
		<input type="text" class="form-control" id="recipient-name" value="{{ issue.key }}" disabled readonly>
	</div> #}
	<div class="mb-3">
		<label for="recipient-name" class="col-form-label">Data rozpoczęcia:</label>
		<input type="datetime-local" class="form-control" id="recipient-name" value="{{ start }}" name="worklog_form_start" id="worklog_form_start" disabled readonly>
	</div>
	<div class="mb-3">
		<label for="recipient-name" class="col-form-label">Czas pracy:</label>
		<input type="text" class="form-control" id="recipient-name" value="{{ timeSpent }}" name="worklog_form_time_spent" id="worklog_form_time_spent"  disabled readonly>
	</div>
	<div class="mb-3">
		<label for="message-text" class="col-form-label">Opis pracy:</label>
		<textarea class="form-control" id="worklog_form_message" name="worklog_form_message"  disabled readonly>{{ message }}</textarea>
	</div>

    <input type="hidden" name="issue_key" value="{{ issue.key }}"/>
    <input type="hidden" name="worklog_id" value="{{ worklog.id }}"/>
</form>
